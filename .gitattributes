# Keep release-manifest hashes identical on Ubuntu and Windows runners.
* text=auto

*.cjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.prisma text eol=lf
*.ps1 text eol=lf
*.psm1 text eol=lf
*.sql text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf

*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff2 binary
*.zip binary
